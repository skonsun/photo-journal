# Required: absolute path to your own photo folder; mounted read-only.
PHOTO_PATH=/path/to/your/photos
# Replace with a unique password of at least 12 characters.
ADMIN_PASSWORD=CHANGE_ME_to_a_unique_long_password
HOST_PORT=8789
IMAGE_TAG=latest
SCAN_INTERVAL=15
# Used when EXIF has no timezone offset, and for file-time fallback.
PHOTO_UTC_OFFSET_HOURS=8
# Original files retain embedded metadata; false disables original viewing.
ALLOW_ORIGINAL=true
# Optional source-build mirror. Official PyPI is the default.
PIP_INDEX_URL=https://pypi.org/simple
